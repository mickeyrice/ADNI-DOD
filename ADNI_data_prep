  filter(SCRNO %in% ADNI$SCRNO) %>%
  arrange(SCRNO, USERDATE) %>%         # sort by SCRNO and date
  group_by(SCRNO) %>%
  slice_head(n = 1) %>%                # take first observation per SCRNO
  ungroup() %>%
  select(SCRNO, raw_total_score)       # just keep what you need

# Now pull only the SCRNO and MOCA columns from the final dataset
