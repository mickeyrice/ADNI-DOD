# Try using ADAS for exclusionary criteria
```{r}
adas_clean <- adas %>%
  filter(!is.na(TOTAL13)) %>%         # remove missing TOTAL13 scores
  filter(TOTAL13 > 9) %>%             # exclude scores ≤ 9
  arrange(SCRNO, USERDATE) %>%        # sort by SCRNO and USERDATE
  group_by(SCRNO) %>%
  slice_head(n = 1) %>%               # keep first date per SCRNO
  ungroup()

n_participants <- nrow(adas_clean)
print(n_participants)

# (Nasreddine et al., 2005). Participants were excluded for potential confounding variables, such as psychotic illness, substance abuse, or discomfort with the required MRI testing and lumbar puncture (Weiner et al., 2014)

adas_final <- adas_clean %>%
  left_join(ptsd %>% select(SCRNO, EXCLUSION), by = "SCRNO") %>%
  filter(is.na(EXCLUSION) | EXCLUSION != 1)
n_final <- nrow(adas_final)
print(n_final)

## Cross reference with participants who have CSF data
# Step 1: Filter CSF to only first RUNDATE per SCRNO
csf_first <- csf %>%
  arrange(SCRNO, RUNDATE) %>%                  # Ensure dates are in order
  group_by(SCRNO) %>%
  slice(1) %>%                                  # Keep first date per participant
  ungroup() %>%
  select(SCRNO, RUNDATE, ABETA, AB40, TAU, PTAU, AB4240)  # Keep only relevant columns

# Step 2: Join to ADAS data
adas_with_csf <- adas_final %>%
  left_join(csf_first, by = "SCRNO") %>%
  filter(
    !is.na(ABETA),
    !is.na(AB40),
    !is.na(TAU),
    !is.na(PTAU),
    !is.na(AB4240)
  )

nrow(adas_with_csf)
```


# Figure out how to calculate MOCA scores to check exclusion criteria
### How did we get the final ADNI data set?
```{r}
# Check MOCA info 
# Join education data
moca_with_edu <- moca %>%
  left_join(select(demo, SCRNO, PTEDUCAT), by = "SCRNO")

# Create the MOCA total score
moca_scored <- moca %>%
  mutate(
    # Serial 7s: max of 3
    serial_7s_score = pmin(SERIAL1 + SERIAL2 + SERIAL3 + SERIAL4 + SERIAL5, 3),

    # Letters: 1 point if ≤1 error
    letters_score = if_else(LETTERS <= 1, 1, 0),

    # F fluency: 1 point if ≥11
    ffluency_score = if_else(FFLUENCY >= 11, 1, 0),

    # Compute domain scores (excluding delayed recall!)
    visuospatial_score = TRAILS + CUBE + CLOCKCON + CLOCKNO + CLOCKHAN,
    naming_score = LION + RHINO + CAMEL,
    attention_score = DIGFOR + DIGBACK + letters_score + serial_7s_score,
    lang_score = REPEAT1 + REPEAT2 + ffluency_score,
    abstraction_score = ABSTRAN + ABSMEAS,
    orientation_score = DATE + MONTH + YEAR + DAY + PLACE + CITY,
    .keep = "all"
)

moca_scored <- moca_scored %>%
  mutate(
    
    # Sum total (out of 30) — excluding memory_score
    raw_total_score = visuospatial_score + naming_score + attention_score +
                      lang_score + abstraction_score + orientation_score)
    
describe(moca_scored$raw_total_score)

selected_subjects <- moca_scored %>%
  filter(SCRNO %in% c("6315"))
print(selected_subjects$raw_total_score)


