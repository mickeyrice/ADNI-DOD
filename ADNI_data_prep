```{r}
# Possible duplicates
CAPSl_filtered %>% 
  count(SCRNO) %>% 
  filter(n > 1)

CAPSc_filtered %>% 
  count(SCRNO) %>% 
  filter(n > 1)

# Keep the rows with the least missing data
CAPSl_filtered <- CAPSl_filtered %>%
  mutate(non_missing = rowSums(!is.na(across(everything())))) %>%
  group_by(SCRNO) %>%
  slice_max(non_missing, with_ties = FALSE) %>%
  ungroup() %>%
  select(-non_missing)

CAPSc_filtered <- CAPSc_filtered %>%
  mutate(non_missing = rowSums(!is.na(across(everything())))) %>%
  group_by(SCRNO) %>%
  slice_max(non_missing, with_ties = FALSE) %>%
  ungroup() %>%
  select(-non_missing)
